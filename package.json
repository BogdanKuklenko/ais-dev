{
  "name": "alex-dosing",
  "private": true,
  "version": "2.4.0",
  "description": "Пульт дозирования и учёта замесов ООО АЛЕКС",
  "author": "ООО АЛЕКС",
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build && node scripts/write-code-patch-manifest.cjs && node scripts/publish-ota-dist.cjs",
    "build:exe": "node scripts/build-exe.cjs",
    "preview": "vite preview",
    "postinstall": "node scripts/ensure-electron.cjs",
    "lint": "tsc --noEmit"
  },
  "build": {
    "appId": "com.alex.dosing.controller",
    "productName": "ALEX Dosing Control",
    "copyright": "ООО АЛЕКС",
    "asar": true,
    "asarUnpack": [
      "dist/**/*"
    ],
    "afterPack": "./scripts/electron-after-pack.cjs",
    "npmRebuild": false,
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "electron-preload.cjs",
      "electron-code-update.cjs",
      "package.json",
      "public/icon.svg",
      "build-info.json"
    ],
    "extraResources": [
      {
        "from": "scripts/apply-code-update.cmd",
        "to": "apply-code-update.cmd"
      }
    ],
    "win": {
      "target": "portable",
      "icon": "public/icon.svg",
      "artifactName": "ALEX_Dosing_Control_Portable.${ext}",
      "signAndEditExecutable": true
    },
    "portable": {
      "artifactName": "ALEX_Dosing_Control_Portable.exe",
      "requestExecutionLevel": "user",
      "unpackDirName": "AlexDosing"
    }
  },
  "dependencies": {},
  "devDependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5"
  }
}
